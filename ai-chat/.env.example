# Copy to .env.local and fill in the keys you want to use.
# Env vars are optional — you can instead paste keys in-app via the ⚙ AI settings
# (stored only in your browser's localStorage).
#
# IMPORTANT: VITE_* vars are embedded in the client bundle. Prefer providing the
# key at runtime via the settings UI for a deployed demo; use env vars for local dev.

# Google Gemini  (free tier: https://aistudio.google.com/apikey)
VITE_GEMINI_API_KEY=

# OpenAI
VITE_OPENAI_API_KEY=

# OpenRouter (one key, many models)
VITE_OPENROUTER_API_KEY=

# Groq
VITE_GROQ_API_KEY=

# Together AI
VITE_TOGETHER_API_KEY=

# Mistral
VITE_MISTRAL_API_KEY=

# DeepSeek
VITE_DEEPSEEK_API_KEY=
