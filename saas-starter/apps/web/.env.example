# Auth.js (next-auth v5)
AUTH_SECRET=replace-me-with-a-long-random-secret
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Optional GitHub OAuth
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Internal API (Hono)
API_URL=http://localhost:4000
# Shared secret for HMAC request tokens to the API (must match the API's value).
API_AUTH_SECRET=replace-me-with-another-long-random-secret

# Shared Postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/saas_starter

# Resend transactional email (optional - dev falls back to console logging)
RESEND_API_KEY=
RESEND_FROM=SaaS Starter <noreply@example.com>
