# Postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/saas_starter

# Hono API
PORT=4000

# Auth.js (next-auth v5)
AUTH_SECRET=replace-me-with-a-long-random-secret
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Optional GitHub OAuth
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Web -> API
API_URL=http://localhost:4000
# Shared secret used to HMAC-sign proxy->API request tokens.
# MUST be identical in the web and API deployments (and distinct from AUTH_SECRET).
API_AUTH_SECRET=replace-me-with-another-long-random-secret

# Stripe (test mode) - leave STRIPE_SECRET_KEY empty to use the built-in
# simulated billing (mock checkout + portal). Fill the keys to go live.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=

# Resend transactional email (optional)
RESEND_API_KEY=
RESEND_FROM=SaaS Starter <noreply@example.com>
